# Production env for docker-compose.production.yaml
# Usage: cp .env.production.example .env  → replace every CHANGE_ME value
# Generate secrets with: openssl rand -hex 64   (SECRET_KEY_BASE)
#                        openssl rand -hex 24   (passwords)

# ---------- Required ----------
SECRET_KEY_BASE=CHANGE_ME_128_HEX_CHARS
# Public URL users open in the browser (no trailing slash)
FRONTEND_URL=https://chat.example.com
# true when served over HTTPS (behind a TLS reverse proxy)
FORCE_SSL=true
# false = only admins can create accounts/invite agents
ENABLE_ACCOUNT_SIGNUP=false

# ---------- Database (service names from docker-compose) ----------
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DATABASE=chatwoot

# ---------- Redis ----------
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---------- Rails ----------
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_MAX_THREADS=5
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# ---------- Email (needed for invites, password resets, notifications) ----------
MAILER_SENDER_EMAIL=Support <support@example.com>
SMTP_DOMAIN=example.com
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# ---------- File storage ----------
# 'local' stores uploads in the storage_data docker volume.
# For S3: set to amazon and fill the AWS_* values below.
ACTIVE_STORAGE_SERVICE=local
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ---------- Optional ----------
# Incoming email channel (e.g. relay, mailgun, mandrill, sendgrid)
MAILER_INBOUND_EMAIL_DOMAIN=
RAILS_INBOUND_EMAIL_SERVICE=
RAILS_INBOUND_EMAIL_PASSWORD=

# Mobile app push notifications via Chatwoot's relay
ENABLE_PUSH_RELAY_SERVER=true

# Integrations — fill only the ones you use
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
IG_VERIFY_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=
AZURE_APP_ID=
AZURE_APP_SECRET=
